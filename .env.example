# Copia este archivo como .env y ajusta los valores.

# --- Seudonimización (OBLIGATORIO). Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
# Guárdalo sólo tú / el profesor. Si se pierde, ya no se pueden vincular sesiones de un mismo alumno.
PSEUDONYM_SECRET=

# --- Panel del profesor
TEACHER_PASSWORD=
GROUPS=1CM1,1CM2,1CM3

# --- Modelos de lenguaje, en orden de preferencia (se usa el siguiente si uno falla o se satura).
# ollama = local en tu laptop (datos no salen). groq / gemini = APIs con plan gratuito.
LLM_CHAIN=ollama:qwen3:8b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
# 0 = plantillas del banco de errores (misma intervención para todos); 1 = el LLM las reescribe
LLM_REPHRASE=0

# --- Servidor
PORT=7860
CONCURRENCY=40
GRADIO_SHARE=0
DB_PATH=data/sesiones.db
